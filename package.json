{
  "name": "premium-home-partners",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run start -w apps/mobile",
    "web": "npm run web -w apps/mobile",
    "build:web": "npm run build:web -w apps/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "sync:pricing": "node scripts/sync-pricing.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
