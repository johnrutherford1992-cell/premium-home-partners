# Copy to .env.local (git-ignored). Every EXPO_PUBLIC_* value is inlined into
# the client bundle at build time, so only put public values here.

# Supabase project (Project Settings → API). Leave both empty to build the
# offline demo only: the app then always runs the local demo store.
EXPO_PUBLIC_SUPABASE_URL=
# The anon / publishable key. Never the service-role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 1 = force offline demo mode even when Supabase is configured
# (the launcher at / with all four roles on one device). Default: unset.
EXPO_PUBLIC_DEMO_MODE=

# 0 = hide the "Demo accounts" card on the sign-in screen. Default: shown.
EXPO_PUBLIC_SHOW_DEMO_ACCOUNTS=
