{
  "expo": {
    "name": "Premium Home Partners",
    "description": "Your private home concierge: maintenance, coordination, and ongoing care, handled.",
    "slug": "premium-home-partners",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.premiumhomepartners.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1E30",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.premiumhomepartners.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Premium Home Partners",
      "themeColor": "#0D1E30",
      "backgroundColor": "#0D1E30",
      "shortName": "Premium Home"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1E30",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Premium Home Partners uses the camera to photograph appliance serial plates and the work your technician completes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "premiumhome",
    "experiments": {
      "typedRoutes": false
    }
  }
}
